FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

COPY ["src/OrderSystem.DbMigrator/OrderSystem.DbMigrator.csproj", "src/OrderSystem.DbMigrator/"]
COPY ["src/OrderSystem.Infrastructure/OrderSystem.Infrastructure.csproj", "src/OrderSystem.Infrastructure/"]
COPY ["src/OrderSystem.Application/OrderSystem.Application.csproj", "src/OrderSystem.Application/"]
COPY ["src/OrderSystem.Domain/OrderSystem.Domain.csproj", "src/OrderSystem.Domain/"]

RUN dotnet restore "src/OrderSystem.DbMigrator/OrderSystem.DbMigrator.csproj"

COPY . .
WORKDIR /src/src/OrderSystem.DbMigrator
RUN dotnet publish "OrderSystem.DbMigrator.csproj" \
    --configuration $BUILD_CONFIGURATION \
    --output /app/publish \
    --no-restore \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:11.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
USER $APP_UID
ENTRYPOINT ["dotnet", "OrderSystem.DbMigrator.dll"]